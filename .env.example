# ─────────────────────────────────────────────────────────────────────────────
# ABC Freight × LaunchDarkly demo configuration
# Copy this file to `.env` (same folder) and fill in the values below.
# `npm run bootstrap` can fill the LaunchDarkly values for you from an API token.
# ─────────────────────────────────────────────────────────────────────────────

# >>> REPLACE: LaunchDarkly server-side SDK key (starts with "sdk-").
# Where: LaunchDarkly → Project settings → Environments → <your environment> → SDK key.
# Used only by the Node server. Never prefix it with VITE_ (that would ship it to the browser).
LD_SDK_KEY=

# >>> REPLACE: LaunchDarkly client-side ID (24 hex characters) for the SAME environment.
# Where: LaunchDarkly → Project settings → Environments → <your environment> → Client-side ID.
# Safe to expose to browsers. The VITE_ prefix is what makes it visible to the React app.
VITE_LD_CLIENT_SIDE_ID=

# Generic flag trigger URL for the `instant-quote` flag (Part 1, remediation).
# Where: Flag `instant-quote` → Settings → Triggers → Add trigger → Generic trigger → Turn flag off.
# LaunchDarkly shows the URL once. Treat it like a secret: anyone with it can turn the flag off.
# Leave empty to fire the trigger by hand with curl or turn the flag off in the UI instead.
LD_TRIGGER_URL=

# ── Optional: only used by `npm run bootstrap` ───────────────────────────────
# Personal API access token with the Writer role (Account settings → Authorization).
LD_API_TOKEN=
# Project and environment keys. A new trial project is usually "default" with
# environments "production" and "test". Use the environment your keys above belong to.
LD_PROJECT_KEY=default
LD_ENVIRONMENT_KEY=production
# Change only if your account is on a non-default LaunchDarkly instance (for example EU).
LD_API_BASE=https://app.launchdarkly.com

# ── Optional: Exa answers for the AI Config demo (Extra credit B) ────────────
# Where: https://dashboard.exa.ai/api-keys
# The AI Config chooses one prompt and one Exa model, served to every customer.
# Without this key the assistant uses a local fallback so the demo still runs.
EXA_API_KEY=

# Port for the Node API server. The web app proxies /api to it.
PORT=3001
